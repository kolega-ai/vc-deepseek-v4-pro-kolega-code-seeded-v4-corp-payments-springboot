# Corporate Payments Portal — local development environment values.
# Copy to .env (or run scripts/setup-env.sh, which also generates CORE_MOCK_API_KEY).
# All of these are documented dev/test values, never production secrets.

# Postgres superuser (docker image bootstrap)
POSTGRES_USER=corpadmin
POSTGRES_PASSWORD=corp_dev_pg_password

# Per-tier database credentials (created by docker/postgres/init/01-create-dbs.sh)
PORTAL_DB_USER=portal
PORTAL_DB_PASSWORD=portal_dev_password
PAYMENT_API_DB_USER=payment_api
PAYMENT_API_DB_PASSWORD=paymentapi_dev_password
CORE_MOCK_DB_USER=core_mock
CORE_MOCK_DB_PASSWORD=coremock_dev_password

# Tier-to-tier token signing secrets (HMAC-SHA256). Must be identical for all tiers.
TIER_TOKEN_SECRET=dev-tier-token-secret-change-me-0a1b2c3d
CORE_SCOPE_SECRET=dev-core-scope-secret-change-me-4e5f6a7b
INTERNAL_SERVICE_TOKEN=dev-internal-service-token-8c9d0e1f

# Core banking credential — set this yourself. scripts/setup-env.sh generates a random
# value when .env is missing it. Never commit a real value.
CORE_MOCK_API_KEY=

# Uploaded documents live here (mounted into the portal container)
PORTAL_UPLOAD_DIR=/data/uploads
